CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS configuration
CONFIG_FREERTOS_HZ=1000

# LVGL configuration
# 屏是 16bit RGB565，必须用 16 位色深：32bpp 时 LVGL 绘制缓冲为 800*50*4=160KB，
# 而 esp_lv_adapter 在 TRIPLE_PARTIAL 模式下强制从内部 RAM 分配
# （display_manager_alloc_draw_buffer 传 use_psram=false），内部 RAM 无 160KB 连续块，
# 启动即报 "alloc primary buffer 160000 bytes failed" 并导致注册显示失败。
#
# 注意：只能改 LV_COLOR_FORMAT_DEFAULT。CONFIG_LV_COLOR_DEPTH 是 Kconfig 派生的 int，
# 其 default 链为 RGB565->16 / RGB888->24，选中 XRGB8888 时不匹配任何分支会落到 default 32。
# 同时 LV_COLOR_DEPTH_CHOICE 已标记 DEPRECATED，设 CONFIG_LV_COLOR_DEPTH_16=y 无效。
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# 刷新周期 22ms(≈45Hz)，与面板扫描率配套：
#   pclk 18MHz 时扫描率 = 18M/(832*496) ≈ 43.6Hz
#   二者接近可避免「LVGL 快于面板 → 持续提交 → 闪烁」。
# 关键：改 pclk（lcd_init_rgb.c 的 HW_LCD_PIXEL_CLOCK_HZ）必须同步改这里，反之亦然。
CONFIG_LV_DEF_REFR_PERIOD=22
CONFIG_LV_DPI_DEF=60
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=24000
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768
CONFIG_LV_DRAW_THREAD_PRIO=4
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=4
CONFIG_LV_GRADIENT_MAX_STOPS=4
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS=y

# Task WDT：LVGL 在 esp_lcd_touch 读 GT911 时若 I2C 挂死，IDLE 会饿死。esp_lcd I2C 传输仍为无限等待，仅靠降速/上拉减负；
# 略增大超时可减少误报（根本仍靠硬件与 100k I2C）。
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
