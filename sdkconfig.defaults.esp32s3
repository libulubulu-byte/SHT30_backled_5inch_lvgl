# ESP32-S3 default configuration

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Default LCD interface: RGB (800x480)
# 本工程配的是 800x480 RGB 屏（ESP32-8048S050 / JC8048W550 一类，16bit RGB565：
# B0-B4=8/3/46/9/1, G0-G5=5/6/7/15/16/4, R0-R4=45/48/47/21/14, PCLK=42, DE=40, VSYNC=41, HSYNC=39, BL=2;
# 触摸 GT911: SDA=19, SCL=20, RST=38, INT=NC）。
# 若误选 SPI/QSPI 接口，LCD 打不出图像，触摸会去用 8/18 脚读 GT911 并直接 NACK。
CONFIG_EXAMPLE_LCD_INTERFACE_RGB=y

# PSRAM configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
# 本工程 PSRAM 只用于 RGB 帧缓冲/图片资源，不需要把代码和只读数据搬进 PSRAM。
# 开启 XIP/RODATA/FETCH_INSTRUCTIONS 会额外占用 PSRAM 并增加缓存压力，故关闭。
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_RODATA=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
